#!/bin/sh
# Retire toute mention d'un assistant IA comme co-auteur (règle d'équipe PULSE).
# À activer une fois par clone : git config core.hooksPath .githooks
msg_file="$1"
tmp="$(mktemp)"
grep -viE '^(co-authored-by:.*(claude|anthropic|noreply@anthropic\.com|copilot|cursor|openai|chatgpt)|claude-session:|.*generated with \[?claude code)' "$msg_file" > "$tmp"
# supprime les lignes vides finales
sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp" > "$msg_file"
rm -f "$tmp"
