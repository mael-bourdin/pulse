{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSE",
  "version": "0.1.0",
  "identifier": "fr.healthaicoach.pulse",
  "build": {
    "beforeDevCommand": "pnpm --filter @pulse/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @pulse/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "title": "PULSE – Coach & Challenges", "width": 1280, "height": 820, "minWidth": 380, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:4000; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
