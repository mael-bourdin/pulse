# Copier en .env à la racine : cp .env.example .env
# Aucun secret réel ici : uniquement de la configuration locale.

# --- Simulateur d'authentification (apps/auth-simulator) ---
AUTH_SIM_PORT=4001
AUTH_SIM_TOKEN_TTL_SECONDS=3600

# --- API PULSE (apps/api) ---
API_PORT=4000
# URL du service d'authentification (simulateur en local, service réel ailleurs)
AUTH_SERVICE_URL=http://localhost:4001
AUTH_SERVICE_TIMEOUT_MS=3000
# Origines autorisées (web en dev + coque Tauri)
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# --- Front web (apps/web) ---
VITE_API_URL=http://localhost:4000
