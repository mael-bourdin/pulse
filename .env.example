# Configuration locale, à copier en .env : aucun secret réel ici.
DATABASE_URL=postgres://localhost/pulse
AUTH_SERVICE_URL=http://localhost:8081
AUTH_TIMEOUT_MS=3000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
LOGIN_RATE_LIMIT_PER_MIN=5
TRUST_PROXY=false
COOKIE_SECURE=false
WEB_DIST_DIR=apps/web/dist
PORT=8080
AUTH_SIM_PORT=8081
AUTH_SIM_UNAVAILABLE=false
AUTH_SIM_CONTROL_TOKEN=
AUTH_SIM_TOKEN_TTL=3600
RUST_LOG=info
PULSE_URL=http://localhost:5173
