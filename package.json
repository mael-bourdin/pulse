{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "description": "PULSE V1 – Coach & Challenges (HealthAI Coach) – MSPR TPRE501",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n auth,api,web -c magenta,blue,green \"pnpm --filter @pulse/auth-simulator dev\" \"pnpm --filter @pulse/api dev\" \"pnpm --filter @pulse/web dev\"",
    "dev:auth": "pnpm --filter @pulse/auth-simulator dev",
    "dev:api": "pnpm --filter @pulse/api dev",
    "dev:web": "pnpm --filter @pulse/web dev",
    "dev:desktop": "pnpm --filter @pulse/desktop dev",
    "auth:down": "node scripts/auth-availability.mjs down",
    "auth:up": "node scripts/auth-availability.mjs up",
    "db:reset": "pnpm --filter @pulse/api db:reset",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm --filter @pulse/web build",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
